# Public, non-sensitive configuration
NEXT_PUBLIC_SITE_ORIGIN=http://localhost:3000

# Server-only environment identity and non-secret provider posture
APP_ENV=local
PROVIDER_PROFILE=synthetic
DELIVERY_PROFILE=capture

