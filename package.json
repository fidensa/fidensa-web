{
  "name": "fidensa-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.21.x",
    "npm": "11.19.x"
  },
  "packageManager": "npm@11.19.0",
  "allowScripts": {
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true
  },
  "scripts": {
    "build": "node scripts/run-next.mjs build",
    "check:toolchain": "node scripts/check-toolchain.mjs",
    "clean-install": "npm ci",
    "db:test": "node scripts/test-database.mjs",
    "dev": "node scripts/run-next.mjs dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "inspect": "node scripts/inspect-artifacts.mjs",
    "lint": "eslint . --max-warnings=0",
    "start": "node scripts/run-next.mjs start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "npm run check:toolchain && npm run format:check && npm run lint && npm run typecheck && npm test && npm run db:test && npm run build && npm run inspect && npm run verify:routes",
    "verify:routes": "node scripts/verify-routes.mjs"
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "svix": "2.5.0",
    "tr46": "6.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/tr46": "5.0.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
